# Now that the Dockerfile builds Flutter inside the image (multi-stage),
# stage 1 needs lib/, web/, assets/, fonts/, pubspec — leave those in.
# Drop the heavy/unrelated trees to keep the upload small.
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies
/.pub-cache/
/.pub/
/.idea/
/.vscode/
/.git/
/.gitignore
/.gitattributes
/.claude/
/android/
/ios/
/linux/
/macos/
/windows/
/test/
/integration_test/
/screenshots/
/coverage/
# We no longer ship a prebuilt build/ — Stage 1 generates it fresh.
/build/
